{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach by Process ID",
      "processId": "${command:PickProcess}",
      "request": "attach",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "API (yarn start)",
      "command": "yarn workspace @clovercoin/api start"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "API (seed create)",
      "command": "yarn workspace @clovercoin/api seed:create foo bar"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "API Integration Tests",
      "command": "yarn workspace @clovercoin/api test-integration"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "API Unit Tests",
      "command": "yarn workspace @clovercoin/api test-unit ${fileBasenameNoExtension}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "test - client (current file)",
      "command": "yarn workspace @clovercoin/client jest ${fileBasenameNoExtension}"
    }
  ]
}
